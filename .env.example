# ─────────────────────────────────────────────────────────────
# Demo request delivery
#
# The form POSTs to /contact.php on the cPanel host, which emails each
# request to demorequest@aurilearn.ai. Who receives those is managed in
# Microsoft 365 as members of that distribution list, not here.
#
# No env file is needed for a production build.
# ─────────────────────────────────────────────────────────────

# OPTIONAL. Overrides the endpoint the form posts to (default:
# /contact.php), for example to point a local build at a test server.
NEXT_PUBLIC_DEMO_FORM_ENDPOINT=
